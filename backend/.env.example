# Copiar como .env y completar con valores reales. Nunca commitear .env real.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.tudominio.com

# Base de datos PostgreSQL
DB_NAME=panaderia
DB_USER=panaderia
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# Dominios de Webflow autorizados a consumir la API (separados por coma)
CORS_ALLOWED_ORIGINS=https://www.tudominio.com

SECURE_SSL_REDIRECT=False

# Google Calendar (opcional: el sistema funciona sin esto, solo no sincroniza).
# GOOGLE_CALENDAR_CREDENTIALS_JSON: el contenido COMPLETO del JSON de la cuenta
# de servicio de Google Cloud (Calendar API habilitada), en una sola línea.
# Comparte el calendario que quieras usar con el email de esa cuenta de servicio
# (termina en @<proyecto>.iam.gserviceaccount.com) con permiso "Realizar cambios
# en los eventos". GOOGLE_CALENDAR_ID es el ID de ese calendario (visible en su
# configuración; para el calendario principal de una cuenta, suele ser su email).
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=
